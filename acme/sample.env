# +--------------+
# Container Timezone
# +--------------+
TZ=Asia/Shanghai

# +--------------+
# Container package fetch url
# +--------------+
#
# +---------------------------+
# Url that can be used:
#
# mirrors.aliyun.com
# mirrors.ustc.edu.cn
# dl-cdn.alpinelinux.org
#
# +---------------------------+
CONTAINER_PACKAGE_URL=mirrors.aliyun.com

# +--------------+
# Account
# +--------------+
ACME_EMAIL=

# +--------------+
# CA server
# +--------------+
# letsencrypt (default), zerossl, buypass, ssl.com, or google
ACME_SERVER=letsencrypt

# +--------------+
# Default mode
# +--------------+
# webroot or dns. A domain config can override this value.
ACME_DEFAULT_MODE=webroot

# +--------------+
# Webroot mode
# +--------------+
ACME_WEBROOT=/usr/share/nginx/html

# +--------------+
# Storage
# +--------------+
ACME_CERT_HOME=/usr/config/acme
ACME_DOMAIN_CONFIG_DIR=/usr/config/acme/domains

# +--------------+
# Key type
# +--------------+
# ec-256, ec-384, 2048, 3072, 4096
ACME_KEYLENGTH=ec-256

# +--------------+
# Renew loop
# +--------------+
# Rescan domain configs and retry failed issuance every hour.
ACME_SYNC_INTERVAL_SECONDS=3600

# Check enabled certificates for renewal every day.
ACME_RENEW_INTERVAL_SECONDS=86400

# +--------------+
# DNS credentials
# +--------------+
# Add only the credentials required by the selected DNS provider.
# Keep real values in acme/.env and never commit them.
#
# Cloudflare example:
# CF_Token=
# CF_Account_ID=
#
# Aliyun example:
# Ali_Key=
# Ali_Secret=
